# ============================================================
# EssentialsX-Clone - Git 忽略配置文件
# 基于 GitHub Java .gitignore 模板
# 最后更新: 2026-07-10
# ============================================================

# ---------- IDE / 编辑器 ----------
.idea/
*.iml
*.ipr
*.iws
out/
*.swp
*.swo
*~
.project
.classpath
.settings/
.vscode/
*.sublime-workspace
*.sublime-project

# ---------- 编译输出 (保留用于发布) ----------
# 注意: target/ 目录需要上传以包含编译产物
# 如果不需要上传编译产物，请取消下面的注释:
# target/

# ---------- Maven ----------
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
pom.xml.backup
pom.xml.~*
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar
.flattened-pom.xml

# ---------- 日志文件 ----------
*.log

# ---------- 包文件 (保留 JAR 用于发布) ----------
# 注意: *.jar 已注释，允许上传编译后的 JAR 包
# *.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# ---------- JVM 崩溃日志 ----------
hs_err_pid*

# ---------- 操作系统文件 ----------

### macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

### Linux
.fuse_hidden*
.directory
.Trash-*
.nfs*

### Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# ---------- 临时文件 ----------
*.tmp
*.temp
*.bak
*.cache
*.pid
*.seed
*.pid.lock

# ---------- 测试覆盖率 ----------
coverage/
jacoco.exec
*.exec

# ---------- 文档生成 ----------
docs/_build/
docs/generated/

# ---------- 本地运行/测试数据 ----------
run/
logs/
data/
*.db
*.sqlite
*.sqlite3

# ---------- 环境变量和敏感信息 ----------
.env
.env.local
.env.*.local
*.pem
*.key
*.crt
credentials.xml
settings-security.xml

# ---------- 备份文件 ----------
*.orig
*.backup
*~

# ---------- 蓝牙文件 (BlueJ) ----------
*.ctxt

# ---------- 其他 ----------
.m2/  # Maven 本地仓库缓存（不应提交）
node_modules/  # Node.js 依赖（如果有的话）
